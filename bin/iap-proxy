#!/bin/bash
# usage: iap-proxy VM PORT -- start the VM if stopped, then open an IAP tunnel on stdin/stdout
VM=$1; PORT=${2:-22}
read -r ZONE STATUS < <(gcloud compute instances list --filter "name=$VM" \
  --format 'value(zone.basename(),status)')
[ -z "${ZONE:-}" ] && { echo "iap-proxy: no VM named $VM" >&2; exit 1; }
if [ "$STATUS" != "RUNNING" ]; then
  echo "iap-proxy: starting $VM ($STATUS)..." >&2
  gcloud compute instances start "$VM" --zone "$ZONE" --quiet >&2
  sleep 25
fi
exec gcloud compute start-iap-tunnel "$VM" "$PORT" --zone "$ZONE" --listen-on-stdin
